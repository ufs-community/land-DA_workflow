&datm_nml
  datamode = "{{ datm_in_datamode }}"
  factorfn_data = "null"
  factorfn_mesh = "null"
  flds_co2 = .false.
  flds_presaero = .false.
  flds_wiso = .false.
  iradsw = 1
  model_maskfile = "INPUT_DATM/{{ datm_in_mask_fn }}"
  model_meshfile = "INPUT_DATM/{{ datm_in_mesh_fn }}"
  nx_global = {{ datm_in_nx_global }}
  ny_global = {{ datm_in_ny_global }}
  restfilm = "null"
  export_all = .true.
/
